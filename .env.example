# Django (development defaults)
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,darkwatch.greyrockstudios.com

# Database
POSTGRES_DB=darkwatch
POSTGRES_USER=darkwatch
POSTGRES_PASSWORD=darkwatch_dev_password
DB_HOST=postgres
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Frontend
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=DarkWatch Pro

# Stripe (optional in dev; required for real checkout/webhooks)
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx
STRIPE_STARTER_PRICE_ID=price_xxxxxxxxxxxx
STRIPE_PROFESSIONAL_PRICE_ID=price_xxxxxxxxxxxx
STRIPE_ENTERPRISE_PRICE_ID=price_xxxxxxxxxxxx

# Email (console backend is dev-only; configure a real provider for production)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For saved local email files, use django.core.mail.backends.filebased.EmailBackend.
EMAIL_FILE_PATH=backend/tmp/emails
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=alerts@darkwatchpro.com
TEAM_INVITE_EXPIRY_HOURS=168
TEAM_INVITE_REQUIRE_SMTP_AUTH=False

# Reports
REPORT_GENERATION_ENABLED=False

# CORS (production)
CORS_ALLOWED_ORIGINS=https://darkwatchpro.com,https://www.darkwatchpro.com,https://darkwatch.greyrockstudios.com

# Frontend URL (used for Stripe redirects)
FRONTEND_URL=http://localhost:3000

# Production reminders:
# - Set DJANGO_DEBUG=False and provide a strong DJANGO_SECRET_KEY.
# - Set DJANGO_ALLOWED_HOSTS, CORS_ALLOWED_ORIGINS, and FRONTEND_URL to deployed domains.
# - Provide live Stripe keys/price IDs only outside development.
# - Do not seed demo data in production.
